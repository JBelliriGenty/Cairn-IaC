{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Cairn IaC: automerge",
      "matchManagers": [
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Database: a patch can still migrate its files, merged by hand",
      "matchDepNames": [
        "postgres"
      ],
      "automerge": false
    }
  ]
}
